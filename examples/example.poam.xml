  <risk uuid="e39a0d15-d7ad-5eb3-9963-eb9f77aed0f0">
    <title>Harvest-now-decrypt-later exposure on TLS key establishment</title>
    <description><p>Classical key exchange provides no protection against a future
      cryptographically relevant quantum computer capturing today's traffic.</p></description>
    <statement><p>Recorded traffic is exposed to retrospective decryption.</p></statement>
    <status>open</status>
  </risk>
  <poam-item uuid="a0f838ed-4bdb-5914-98b0-2f93f4113de1">
    <title>Migrate TLS key exchange to PQ-hybrid (X25519MLKEM768)</title>
    <description><p>Endpoint offers classical-only key exchange on the control path.</p></description>
    <prop ns="https://breachsafe.ai/ns/oscal" name="control" value="sc-13"/>
    <prop ns="https://breachsafe.ai/ns/oscal" name="control" value="sc-12"/>
    <prop ns="https://breachsafe.ai/ns/oscal" name="sc-13_odp.02" value="CNSA 2.0 PQC required"/>
    <prop ns="https://breachsafe.ai/ns/oscal" name="severity" value="medium"/>
