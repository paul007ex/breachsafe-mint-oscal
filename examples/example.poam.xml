  <observation uuid="aa1d5f56-b098-5ca1-b342-b568add3bb7f">
    <title>Classical key exchange negotiated (quantum-vulnerable)</title>
    <description><p>TLS 1.3 control probe negotiated classical X25519; the certificate
      signature is ecdsa-with-SHA384. Neither is post-quantum.</p></description>
    <prop ns="https://breachsafe.ai/ns/oscal" name="readiness" value="quantum_vulnerable"/>
    <prop ns="https://breachsafe.ai/ns/oscal" name="algorithm" value="X25519"/>
    <prop ns="https://breachsafe.ai/ns/oscal" name="nistQuantumSecurityLevel" value="0"/>
    <prop ns="https://breachsafe.ai/ns/oscal" name="cert-signature" value="ecdsa-with-SHA384"/>
    <prop ns="https://breachsafe.ai/ns/oscal" name="command-sha256" value="81e11081862953f8e83315321fb56d5cb066ac6d2669bf99599a757f94bc173a"/>
